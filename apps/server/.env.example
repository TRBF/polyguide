PORT=8787
# Set USE_MOCK=1 only to serve fixtures instead of the real graph.
USE_MOCK=0
# ENABLE_DEV_ROUTES=1  # exposes /api/dev/compare (calls ETH); never on a public tunnel
# Secret: share privately, never commit. Without it, guidance still works (no camera AI).
OPENAI_API_KEY=
# Tested 2026-10-10 on an HG room-sign photo: reads the sign correctly in ~2-2.6 s.
# (gpt-4o-mini ~2.5-3 s also fine; gpt-4.1-mini ~4 s too slow; gpt-4.1-nano missed signs.)
OPENAI_VISION_MODEL=gpt-5.4-mini
# Voice commands; empty = use OPENAI_VISION_MODEL (gpt-5.4-mini answers in ~0.6-1.5 s).
OPENAI_TEXT_MODEL=
# Speech to text for voice commands (POST /api/stt). gpt-4o-mini-transcribe by default (more accurate than whisper-1).
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Reasoning models only; low keeps vision latency down. Leave empty for non-reasoning models (e.g. gpt-4o-mini).
OPENAI_REASONING_EFFORT=low
# Conversational voice (speech to speech over WebRTC, POST /api/realtime/session). The browser talks to OpenAI
# directly with a 10-minute client secret; the key stays here. First audio ~0.5-1 s after the user stops talking.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# minimal | low | medium: low reads signs and plans reliably; minimal answers a little faster.
OPENAI_REALTIME_REASONING_EFFORT=low
