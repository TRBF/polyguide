{
  "name": "polyguide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:server": "pnpm --filter @polyguide/server dev",
    "dev:web": "pnpm --filter @polyguide/web dev",
    "fetch:eth": "pnpm --filter @polyguide/scripts fetch:eth",
    "fetch:room-photos": "pnpm --filter @polyguide/scripts fetch:room-photos",
    "build:graph": "pnpm --filter @polyguide/scripts build:graph",
    "route": "pnpm --filter @polyguide/scripts route",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
